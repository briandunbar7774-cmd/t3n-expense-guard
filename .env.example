# Copy to .env and fill after Google SSO claim at:
# https://go.terminal3.io/adk-community
# (lands on https://terminal3.io/products/agent-developer-kit)
#
# IMPORTANT: The claim page shows each key ONCE. Store offline. Do not paste
# real keys into git, chat, or the public Google Doc.

# Tenant / developer key from first claim (Ethereum-style 0x… hex)
T3N_API_KEY=0x_REPLACE_WITH_TENANT_KEY_FROM_CLAIM_PAGE

# Separate agent key — claim AGAIN for the agent (own credits). Never reuse T3N_API_KEY.
AGENT_KEY=0x_REPLACE_WITH_AGENT_KEY_FROM_SECOND_CLAIM

# Cluster — Quickstart docs use testnet
T3N_ENV=testnet

# Optional: after `t3n whoami` / auth scripts succeed, you may record DIDs locally
# (DIDs are not secrets, but leave blank until read back from the network)
# TENANT_DID=did:t3n:
# AGENT_DID=did:t3n:
