{
  "type": "https://eips.ethereum.org/EIPS/eip-8004#registration-v1",
  "name": "Expense Guard",
  "description": "Enterprise expense-policy agent on T3N. Validates expense requests against org policy inside a TEE-backed flow; never holds raw bank account numbers in prompts. Replace endpoints after you host your A2A/MCP surfaces.",
  "services": [
    {
      "name": "A2A",
      "endpoint": "https://REPLACE_ME.example/.well-known/agent-card.json",
      "version": "0.3.0"
    },
    {
      "name": "MCP",
      "endpoint": "https://REPLACE_ME.example/mcp/",
      "version": "2025-06-18"
    },
    {
      "name": "DID",
      "endpoint": "did:t3n:REPLACE_WITH_AGENT_DID_FROM_WHOAMI",
      "version": "v1"
    }
  ],
  "x402Support": false,
  "active": true,
  "registrations": [],
  "supportedTrust": ["tee-attestation"]
}
